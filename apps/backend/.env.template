## Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/medusa-backend
DB_NAME=medusa-backend

## Security & Secrets (Generate secure random values for production)
JWT_SECRET=change_me_to_secure_random_string
COOKIE_SECRET=change_me_to_secure_random_string

## CORS Configuration
# Specify allowed origins for API access (comma-separated)
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

## Redis Configuration (optional - required for production with multiple instances)
# If not set, a fake Redis instance will be used for development
REDIS_URL=redis://localhost:6379

## Optional: Payment Gateway Integration
# STRIPE_API_KEY=sk_live_your_stripe_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

## Optional: Email Service (for order notifications)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key

## Optional: Mistral AI (for AI search feature)
# MISTRAL_API_KEY=your_mistral_api_key

## Optional: File Storage
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=your_bucket_name

## Optional: Admin UI Port (default: 9000)
# ADMIN_UI_PORT=9000

## Optional: API Port (default: 9000)
# API_PORT=9000

